<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F7FF"
    android:padding="16dp">

    <!-- כותרת -->
    <TextView
        android:id="@+id/backgrounds_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎨 BACKGROUNDS:"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1A73E8"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="24dp" />

    <!-- גריד רקעים -->
    <GridLayout
        android:id="@+id/backgrounds_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/backgrounds_title"
        android:layout_centerHorizontal="true"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true">

        <!-- רקע כחול -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#D6E9FF"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:id="@+id/bg_blue"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/blue_bk"
                android:contentDescription="Blue"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blue"
                android:textColor="#1A73E8"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ירוק -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#E3F7E3"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:id="@+id/bg_green"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/green_bk"
                android:contentDescription="Green"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Green"
                android:textColor="#388E3C"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- אפור -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#EEEEEE"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:id="@+id/bg_grey"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/grey_bk"
                android:contentDescription="Grey"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grey"
                android:textColor="#616161"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- תכלת -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#E0F7FA"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:id="@+id/bg_light_blue"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/light_blue_bk"
                android:contentDescription="Light Blue"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Light Blue"
                android:textColor="#039BE5"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- כתום -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#FFE0B2"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:id="@+id/bg_orange"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/orange_bk"
                android:contentDescription="Orange"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Orange"
                android:textColor="#F57C00"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </GridLayout>

    <!-- טקסט בחירה נוכחית -->
    <TextView
        android:id="@+id/selected_background_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selected: None"
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/backgrounds_grid"
        android:layout_marginTop="24dp" />

    <!-- כפתור שמירה -->
    <Button
        android:id="@+id/save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1A73E8"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/selected_background_text"
        android:layout_marginTop="16dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp" />
</RelativeLayout>
