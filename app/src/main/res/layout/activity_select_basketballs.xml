<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F2"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/balls_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏀 Select Your Basketball"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#F57C00"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="16dp" />

    <!-- Dynamic grid container -->
    <GridLayout
        android:id="@+id/balls_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/balls_title"
        android:layout_marginTop="8dp"
        android:columnCount="3"
        android:useDefaultMargins="true"
        android:alignmentMode="alignMargins" />

    <!-- Selected label -->
    <TextView
        android:id="@+id/selected_ball_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selected: None"
        android:textSize="18sp"
        android:textColor="#333333"
        android:layout_below="@id/balls_grid"
        android:layout_marginTop="24dp"
        android:layout_centerHorizontal="true" />

    <!-- Save button -->
    <Button
        android:id="@+id/save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save Selection"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#F57C00"
        android:layout_below="@id/selected_ball_text"
        android:layout_marginTop="16dp"
        android:layout_centerHorizontal="true"
        android:paddingLeft="24dp"
        android:paddingRight="24dp" />

</RelativeLayout>