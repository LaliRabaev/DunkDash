<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF7"
    android:padding="16dp">

    <!-- כותרת -->
    <TextView
        android:id="@+id/modes_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎮 MODES:"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="24dp" />

    <!-- Return Button -->
    <Button
        android:id="@+id/button_return_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Return"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"/>

    <!-- Grid של מצבים -->
    <GridLayout
        android:id="@+id/modes_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/modes_title"
        android:layout_centerHorizontal="true"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true">

        <!-- Easy -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#C8E6C9"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:id="@+id/mode_easy"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/splash_screen"
                android:contentDescription="Easy Mode"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Easy"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Medium -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#FFF9C4"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:id="@+id/mode_medium"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/splash_screen"
                android:contentDescription="Medium Mode"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medium"
                android:textColor="#F9A825"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Hard -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#FFCDD2"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:id="@+id/mode_hard"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/splash_screen"
                android:contentDescription="Hard Mode"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hard"
                android:textColor="#C62828"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </GridLayout>

    <!-- תצוגת מצב נבחר -->
    <TextView
        android:id="@+id/selected_mode_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selected: None"
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/modes_grid"
        android:layout_marginTop="24dp" />

    <!-- כפתור Save -->
    <Button
        android:id="@+id/save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3F51B5"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/selected_mode_text"
        android:layout_marginTop="16dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp" />
</RelativeLayout>
