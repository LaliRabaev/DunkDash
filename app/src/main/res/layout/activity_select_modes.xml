<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF7"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top bar: Return button and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/button_return_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:text="←"
            android:textSize="24sp"
            android:textColor="#3F51B5"
            android:layout_marginEnd="12dp"
            android:elevation="2dp"
            android:padding="0dp"/>

        <TextView
            android:id="@+id/modes_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Mode"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Grid of modes -->
    <GridLayout
        android:id="@+id/modes_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:useDefaultMargins="true"
        android:alignmentMode="alignMargins"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <!-- Easy -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#C8E6C9"
            android:padding="8dp"
            android:layout_margin="8dp"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/mode_easy"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/splash_screen"
                android:contentDescription="Easy Mode"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Easy"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Medium -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#FFF9C4"
            android:padding="8dp"
            android:layout_margin="8dp"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/mode_medium"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/splash_screen"
                android:contentDescription="Medium Mode"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medium"
                android:textColor="#F9A825"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Hard -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#FFCDD2"
            android:padding="8dp"
            android:layout_margin="8dp"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/mode_hard"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/splash_screen"
                android:contentDescription="Hard Mode"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hard"
                android:textColor="#C62828"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </GridLayout>

    <!-- Selected Mode -->
    <TextView
        android:id="@+id/selected_mode_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selected: None"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Save Button -->
    <Button
        android:id="@+id/save_button"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3F51B5"
        android:layout_gravity="center_horizontal"
        android:textSize="16sp"
        android:elevation="2dp"
        android:layout_marginTop="8dp"/>
</LinearLayout>
