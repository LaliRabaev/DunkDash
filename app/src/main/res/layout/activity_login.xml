<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/leaderboard_background"
    android:padding="16dp"
    tools:context=".LoginActivity">

    <!-- Logo Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp">

        <!-- Logo Image -->
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_logo"
            android:src="@drawable/app_logo_for_login_page"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏀 Welcome Back!"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to continue playing"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_gravity="center" />

    </LinearLayout>

    <!-- Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Login/Register Toggle -->
            <LinearLayout
                android:id="@+id/toggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/leaderboard_normal_background"
                android:padding="3dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/loginButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="🔑 Login"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4A4A4A"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/signupButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="✨ Sign Up"
                    android:textColor="#CCCCCC"
                    android:backgroundTint="@android:color/transparent"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Email Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/leaderboard_normal_background"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📧 Email Address"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/usernameInput"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:hint="Enter your email address"
                    android:textColorHint="#AAAAAA"
                    android:textColor="#FFFFFF"
                    android:inputType="textEmailAddress"
                    android:padding="10dp"
                    android:background="@android:color/transparent"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Password Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/leaderboard_normal_background"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Password"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RelativeLayout
                    android:id="@+id/passwordLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:hint="Enter your password"
                        android:textColorHint="#AAAAAA"
                        android:textColor="#FFFFFF"
                        android:inputType="textPassword"
                        android:padding="10dp"
                        android:paddingEnd="50dp"
                        android:background="@android:color/transparent"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/togglePasswordVisibility"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Toggle password visibility"
                        android:src="@drawable/ic_visibility_off" />

                </RelativeLayout>

            </LinearLayout>

            <!-- Forgot Password -->
            <TextView
                android:id="@+id/forgotPasswordText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔗 Forgot Password?"
                android:textColor="#FF9800"
                android:textSize="14sp"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Buttons Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Login Button -->
        <Button
            android:id="@+id/doneButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🚀 Sign In"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/leaderboard_current_user_background"
            android:layout_marginBottom="10dp" />

        <!-- Developer Login Button -->
        <Button
            android:id="@+id/devLoginButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="⚡ DEV LOGIN"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/leaderboard_bronze_background"
            android:alpha="0.8" />

    </LinearLayout>

</LinearLayout>



