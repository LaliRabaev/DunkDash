<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GameActivity">

    <!-- Dynamic game background -->
    <ImageView
        android:id="@+id/game_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#DDDDDD"
        android:src="@null" />

    <!-- Top barrier with 7 cones -->
    <LinearLayout
        android:id="@+id/top_barrier_container"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:rotation="180"
        android:layout_alignParentTop="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/top_cone1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/top_cone2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/top_cone3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/top_cone4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/top_cone5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/top_cone6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/top_cone7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />
    </LinearLayout>

    <!-- Bottom barrier with 7 cones -->
    <LinearLayout
        android:id="@+id/bottom_barrier_container"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bottom_cone1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/bottom_cone2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/bottom_cone3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/bottom_cone4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/bottom_cone5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/bottom_cone6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />

        <ImageView
            android:id="@+id/bottom_cone7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/game_cone" />
    </LinearLayout>

    <!-- Left & Right dynamic obstacle containers -->
    <FrameLayout
        android:id="@+id/left_cones_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true" />

    <FrameLayout
        android:id="@+id/right_cones_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true" />

    <!-- Dynamic player basketball -->
    <ImageView
        android:id="@+id/player_basketball"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:layout_centerInParent="true"
        android:background="@android:color/transparent"
        android:src="@null" />

</RelativeLayout>
