<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Audio Test"
        android:textSize="24sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/testShootButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Test Shoot Sound"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/testScoreButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Test Score Sound"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/testMissButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Test Miss Sound"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/testClickButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Test Click Sound"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/testGameOverButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Test Game Over Sound"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/testMusicToggle"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Start Background Music"
        android:layout_marginBottom="16dp" />

</LinearLayout>