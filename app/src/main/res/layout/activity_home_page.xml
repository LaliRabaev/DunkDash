<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomePageActivity">

    <!-- Placeholder background: will be replaced in code -->
    <ImageView
        android:id="@+id/home_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#DDDDDD"
        android:src="@null" />

    <!-- User info panel at top - removed background and moved higher -->
    <LinearLayout
        android:id="@+id/user_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="16dp"
        android:padding="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/greeting_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello, Player!"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/max_score_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFD700"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Score"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:shadowColor="#000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="#FFFFFF"
                android:alpha="0.8" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/total_games_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#87CEEB"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Games Played"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:shadowColor="#000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Placeholder basketball: replaced in code -->
    <ImageView
        android:id="@+id/player_basketball"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:layout_centerInParent="true"
        android:background="@android:color/transparent"
        android:src="@null" />

    <!-- “Start Playing” text -->
    <TextView
        android:id="@+id/startText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/player_basketball"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:text="@string/start_playing"
        android:textColor="@color/orange"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Right‑side icon column -->
    <LinearLayout
        android:id="@+id/iconContainerRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <ImageView
            android:id="@+id/cup_icon"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/cup_icon" />

        <ImageView
            android:id="@+id/leaderboard_icon"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/leaderboard_icon" />

        <ImageView
            android:id="@+id/setting_icon"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:src="@drawable/setting_icon" />
    </LinearLayout>

    <!-- Left‑side icon column -->
    <LinearLayout
        android:id="@+id/iconContainerLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/ball_icon"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ball_icon"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/pitches_icon"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/pitches_icon"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/skull_icon"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:src="@drawable/skull_icon"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</RelativeLayout>